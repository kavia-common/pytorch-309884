{"is_source_file": true, "format": "C++ header", "description": "This file contains function declarations, type definitions, and macro definitions related to CPU-based BLAS (Basic Linear Algebra Subprograms) operations, specifically for matrix multiplication (GEMM), batched GEMM, and related operations in the ATen library (PyTorch core). It sets up dispatch stubs, type aliases, and function templates for various data types used in CPU linear algebra computations.", "external_files": ["<ATen/OpMathType.h>", "<ATen/native/DispatchStub.h>", "<ATen/native/TransposeType.h>", "<c10/util/complex.h>", "<c10/core/ScalarType.h>", "<c10/core/Scalar.h>"], "external_methods": ["c10::CppTypeToScalarType", "DECLARE_DISPATCH", "kCPU"], "published": ["gemm_stub", "gemm_no_downcast_stub", "brgemm", "pack", "could_pack"], "classes": [], "methods": [{"name": "normalize_last_dims", "description": "Normalizes tensor dimensions for transpose operations, adjusting leading dimension parameters (lda, ldb, ldc) based on transpose types."}, {"name": "gemm", "description": "Performs matrix multiplication for various data types, with template specialization for scalar types, wrapping dispatch to backend kernel implementations."}, {"name": "gemm_batched", "description": "Performs batched matrix multiplication for a batch of matrices with a common API template."}, {"name": "gemm_batched_with_stride", "description": "Performs batched matrix multiplication with specified stride between matrices."}, {"name": "axpy", "description": "Performs the AXPY operation (y := a * x + y) for different data types, with templates for scalar multiplication and vector addition."}, {"name": "copy", "description": "Copies data between memory buffers for various data types, with special handling for small vector cases."}, {"name": "brgemm", "description": "Batch-reduce General Matrix Multiply functions for multiple data types, with APIs for hardware-accelerated batched matrix multiplications."}, {"name": "release_brgemm", "description": "Releases hardware context resources for batched GEMM operations."}, {"name": "pack", "description": "Prepares or packs matrix data for improved performance during multiplication."}, {"name": "could_pack", "description": "Checks platform support for data packing in GEMM operations."}, {"name": "DECLARE_DISPATCH(axpy_fn,axpy_stub)", "scope": "at::native::cpublas", "scopeKind": "namespace", "description": "unavailable"}, {"name": "DECLARE_DISPATCH(copy_fn,copy_stub)", "scope": "at::native::cpublas", "scopeKind": "namespace", "description": "unavailable"}, {"name": "DECLARE_DISPATCH(gemm_no_downcast_fn,gemm_no_downcast_stub)", "scope": "at::native::cpublas", "scopeKind": "namespace", "description": "unavailable"}], "calls": ["internal::normalize_last_dims", "gemm_stub", "gemm_no_downcast_stub", "axpy_stub", "copy_stub", "brgemm", "brgemm_release", "c10::CppTypeToScalarType"], "search-terms": ["CPU Blas", "GEMM template", "brgemm API", "ATen native", "matrix multiplication"], "state": 2, "file_id": 1176, "knowledge_revision": 20572, "git_revision": "d2368aa6f38416345cc0c1393efafe7413d1a324", "ctags": [{"_type": "tag", "name": "CPUBLAS_BRGEMM_BF16BF16F32", "path": "/home/kavia/workspace/code-generation/pytorch-309884/aten/src/ATen/native/CPUBlas.h", "pattern": "/^#define CPUBLAS_BRGEMM_BF16BF16F32 /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "CPUBLAS_BRGEMM_F16F16F32", "path": "/home/kavia/workspace/code-generation/pytorch-309884/aten/src/ATen/native/CPUBlas.h", "pattern": "/^#define CPUBLAS_BRGEMM_F16F16F32 /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "CPUBLAS_BRGEMM_F32F32F32", "path": "/home/kavia/workspace/code-generation/pytorch-309884/aten/src/ATen/native/CPUBlas.h", "pattern": "/^#define CPUBLAS_BRGEMM_F32F32F32 /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "CPUBLAS_BRGEMM_I8I8I32", "path": "/home/kavia/workspace/code-generation/pytorch-309884/aten/src/ATen/native/CPUBlas.h", "pattern
l_norm", "torch.nn.utils.parametrize.type_before_parametrizations"], "classes": [{"name": "TestNNParametrization", "description": "A unittest test case class that encapsulates multiple tests verifying the functionality and robustness of neural network parametrizations, including registration, removal, serialization, deep copy, transfer, and behavior under training/evaluation modes, multi-input scenarios, nested parametrizations, and spectral normalization."}], "methods": [{"name": "test_register_and_remove_parametrization", "description": "Tests registering, applying, and removing parametrizations on a linear layer, including nested parametrizations and edge cases with unsafe flags."}, {"name": "test_register_and_remove_nested_parametrization", "description": "Verifies nesting of parametrizations within existing parametrization modules and ensures correct removal and state consistency."}, {"name": "test_register_and_remove_buffer_parametrization", "description": "Tests applying parametrizations to buffers (like biases) and their removal, verifying that buffer transformations are correctly managed."}, {"name": "test_serialization_parametrization", "description": "Checks that models with parametrizations can be serialized and deserialized correctly via state_dict, maintaining the original state."}, {"name": "test_initialization_parametrization", "description": "Tests registering parametrizations that implement a 'right_inverse' method, verifying correct initialization behavior."}, {"name": "test_errors_unparametrized_tensor_parametrization", "description": "Ensures proper error handling when attempting to parametrized a tensor without parameters, invalid right_inverse implementations, or incompatible shapes/dtypes."}, {"name": "test_errors_parametrized_tensor_parametrization", "description": "Verifies error conditions when registering invalid parametrizations on already parametrized tensors, including incorrect return types or dtype/shape changes."}, {"name": "test_multiple_inputs_parametrization", "description": "Tests parametrizations that accept multiple inputs and produce multiple outputs, ensuring correctness of forward and inverse, and proper removal."}, {"name": "test_new_spectral_norm", "description": "Unit test for spectral normalization parametrization, including registration, application, removal, correctness, and behavior in training/eval modes and multi-GPU scenarios."}, {"name": "test_register_parametrization_no_grad", "description": "Tests registering parametrizations with no gradient requirement, ensuring both original and parametrized tensors reflect this property."}, {"name": "test_caching_parametrization", "description": "Verifies that caching of parametrized tensors works correctly, attributes refer to the same object during cached context."}, {"name": "test_caching_parametrization_with_transfer_parametrizations_and_params", "description": "Ensures that transferring parametrizations between modules maintains correctness and independent state, including caching behaviors."}, {"name": "test_parametrization_same_training_mode", "description": "Checks that the training/eval mode status propagates correctly through parametrizations."}, {"name": "test_type_before_parametrizations", "description": "Verifies that the 'type_before_parametrizations' function returns the original class type of modules before registration."}, {"name": "test_deepcopy_after_parametrization", "description": "Tests that deep copying parametrized modules produces correct, independent duplicates with preserved state."}, {"name": "test_transfer_parametrizations_and_params", "description": "Verifies transfer of all parametrizations and their associated parameters from one module to another, including nested and multiple parameter cases."}, {"name": "test_transfer_parametrizations_and_params_right_inverse", "description": "Checks correctness of transfer in modules with parametrizations that have 'right_inverse' methods."}, {"name": "test_transfer_parametrizations_and_params_single_param", "description": "Verifies transfer of parametrizations on a single parameter (like weight and bias) between modules."}, {"name": "test_transfer_parametrizations_and_params_many_to_one", "description": "Tests complex transfer where a parametrization maps multiple inputs into a single tensor, ensuring consistency and correctness."}, {"name": "test_new_spectral_norm", "description": "Repeated for completeness; already described above, verifies spectral normalization parametrizations."}, {"name": "test_new_spectral_norm_dim", "description": "Tests spectral normalization registration on convolutional layers with various input tensor shapes and ensures internal u vectors align with expected dimensions."}, {"name": "test_new_spectral_norm_forward", "description": "Verifies that the spectral normalization correctly rescales weights during forward passes and the output matches manual calculations."}, {"name": "test_new_spectral_norm_value", "description": "Ensures the spectral norm computed matches the largest singular value of the weight matrix, using a diagonal matrix example."}, {"name": "test_orthogonal_parametrization", "description": "Tests the orthogonal parametrization, verifying that the weight matrices remain orthogonal after updates, including initialization, gradient steps, and different parametrizations such as Cayley, matrix exponential, and Householder."}, {"name": "test_orthogonal_errors", "description": "Checks for proper error handling when invalid input or configurations are used with the orthogonal parametrization."}, {"name": "test_weight_norm_state_dict_compat", "description": "Verifies that models using weight normalization can load state dicts correctly and produce identical outputs."}, {"name": "test_weight_norm_pickle", "description": "Ensures that models with weight normalization cannot be pickled directly, raising appropriate errors."}, {"name": "test_weight_norm_deepcopy", "description": "Verifies that d
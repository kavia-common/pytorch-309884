{"is_source_file": true, "format": "Python", "description": "This file defines two training callback classes for PyTorch Lightning that facilitate post-training and in-training model sparsification by integrating with data sparsifier and scheduler classes. It includes class definitions, methods for callback hooks, and external utilities for attaching models and logging, specifically tailored for a pruning dataset utility within a Lightning training workflow.", "external_files": ["./_data_sparstity_utils"], "external_methods": ["_attach_model_to_data_sparsifier", "_get_valid_name", "_log_sparsified_level"], "published": ["PostTrainingDataSparsity", "TrainingAwareDataSparsity"], "classes": [{"name": "PostTrainingDataSparsity", "description": "Lightning callback that enables post-training sparsity by copying and sparsifying the model after training, without modifying the original model."}, {"name": "TrainingAwareDataSparsity", "description": "Lightning callback for in-training sparsification that manages a data sparsifier and scheduler, performing operations at various training stages to sparsify the model progressively."}], "methods": [{"name": "None on_fit_end(self, trainer, pl_module)", "description": "Performs model copying, attaches it to the sparsifier, and applies sparsification steps at the end of training fit.", "scope": "PostTrainingDataSparsity", "scopeKind": "class"}, {"name": "None on_train_start(self, trainer, pl_module)", "description": "Initializes the sparsifier and scheduler objects, attaching the model to the sparsifier at the start of training.", "scope": "TrainingAwareDataSparsity", "scopeKind": "class"}, {"name": "on_train_epoch_start(self, trainer, pl_module)", "description": "Loads the sparsifier's state dict at the beginning of each epoch, if available.", "scope": "TrainingAwareDataSparsity", "scopeKind": "class"}, {"name": "__create_config_based_on_state(self, pl_module)", "description": "Creates a configuration dictionary based on the current state of the sparsifier for each parameter.", "scope": "TrainingAwareDataSparsity", "scopeKind": "class"}, {"name": "on_train_epoch_end(self, trainer, pl_module)", "description": "Copies the current model, updates the sparsifier's configuration, performs sparsification and scheduler steps, and saves the sparsifier's state dict at epoch end.", "scope": "TrainingAwareDataSparsity", "scopeKind": "class"}, {"name": "on_train_end(self, trainer, pl_module)", "description": "Finalizes the sparsification process by squashing the sparsifier's masks after training ends.", "scope": "TrainingAwareDataSparsity", "scopeKind": "class"}, {"name": "__init__( self, data_sparsifier_class, data_sparsifier_args, data_scheduler_class, data_scheduler_args, )", "scope": "TrainingAwareDataSparsity", "scopeKind": "class", "description": "unavailable"}, {"name": "__init__(self, data_sparsifier_class, data_sparsifier_args)", "scope": "PostTrainingDataSparsity", "scopeKind": "class", "description": "unavailable"}], "calls": ["_attach_model_to_data_sparsifier", "_get_valid_name", "_log_sparsified_level"], "search-terms": ["Lightning callback", "data sparsifier", "model sparsification", "post-training sparsity", "in-training sparsity", "scheduler", "deepcopy", "squash_mask", "data_sparsifier_class", "data_scheduler_class"], "state": 2, "file_id": 6615, "knowledge_revision": 26001, "git_revision": "94f6f79e271f69851ba29f921539c630925a174d", "ctags": [{"_type": "tag", "name": "PostTrainingDataSparsity", "path": "/home/kavia/workspace/code-generation/pytorch-309884/torch/ao/pruning/_experimental/data_sparsifier/lightning/callbacks/data_sparsity.py", "pattern": "/^class PostTrainingDataSparsity(pl.callbacks.Callback):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "TrainingAwareDataSparsity", "path": "/home/kavia/workspace/code-generation/pytorch-309884/torch/ao/pruning/_experimental/data_sparsifier/lightning/callbacks/data_sparsity.py", "pattern": "/^class TrainingAwareDataSpa
ant_tensor_in_aot_bwd", "description": "Tests that deepcopying constant tensors within custom autograd functions in AOT backward does not raise."}, {"name": "test_module_attribute_error", "description": "Tests that attribute errors in modules are properly propagated, including during compilation."}, {"name": "test_torch_cuda_is_initialized", "description": "Verifies that torch.cuda.is_initialized() behaves correctly during compiled functions."}, {"name": "test_named_tuple_vt_clone", "description": "Checks proper handling of namedtuples and their cloning in compiled modules to prevent unnecessary recompilation."}, {"name": "test_zero_dim_param_mixed_device_grad", "description": "Tests parameters with zero dimensions on CPU and their gradients on CUDA, ensuring correct device placement and no recompile."}, {"name": "test_cuda_sync", "description": "Verifies that CUDA synchronization works correctly during traced functions, measuring recompile count."}, {"name": "test_filter_warnings", "description": "Ensures that specific warnings are properly filtered and deduplicated during execution."}, {"name": "test_filter_safe_grad_warning", "description": "Checks that safe_grad utility filters warnings about non-leaf grads appropriately."}, {"name": "test_filter_user_warnings", "description": "Verifies that user-defined warning filters function as expected, suppressing specific warnings in context."}, {"name": "test_partial_export", "description": "Tests partial function modifications for export and proper behavior when captured in a graph."}, {"name": "test_current_accelerator", "description": "Verifies that calls to current_accelerator() within compiled functions do not cause recompilation."}, {"name": "test_pytree_get_node_type_not_traced", "description": "Checks that internal pytree functions (_get_node_type) are not traced and that compiled code behaves correctly with pytree structures including dicts and lists."}, {"name": "test_pytree_get_node_type_with_namedtuple", "des
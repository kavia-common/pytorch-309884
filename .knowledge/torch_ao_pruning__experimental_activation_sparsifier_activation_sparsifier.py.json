{"is_source_file": true, "format": "Python", "description": "This file defines the ActivationSparsifier class, which provides functionality to register layers for activation sparsification, compute and update sparsification masks based on activation data, and apply sparsification during model inference. The class includes methods for hook management, state saving/loading, and configuration customization, supporting the process of pruning activations in neural networks within a PyTorch-based project.", "external_files": ["torch/ao/pruning/sparsifier/utils.py"], "external_methods": ["fqn_to_module", "module_to_fqn"], "published": ["ActivationSparsifier"], "classes": [{"name": "ActivationSparsifier", "description": "A class to sparsify/prune activations in a neural network by attaching hooks to layers, maintaining masks, and applying them during forward passes. It supports registering layers, computing masks based on activation data, and squashing masks into the model."}], "methods": [{"name": "_safe_rail_checks(args)", "description": "Checks that provided functions are callable and features are properly configured.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "register_layer( self, layer: nn.Module, aggregate_fn=None, reduce_fn=None, mask_fn=None, features=None, feature_dim=None, **sparse_config, )", "description": "Registers a layer with the sparsifier, attaching a pre-forward hook for activation aggregation and configuration.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "get_mask(self, name: str | None = None, layer: nn.Module | None = None)", "description": "Retrieves the current sparsification mask for a given layer.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "unregister_layer(self, name)", "description": "Removes a registered layer and its hooks from the sparsifier.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "step(self)", "description": "Updates masks for all registered layers based on aggregated activation data.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "update_mask(self, name, data, configs)", "description": "Computes new masks based on the aggregated data using reduce_fn and mask_fn.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "_sparsify_hook(self, name)", "description": "Returns a hook that applies the current mask to the input activations during forward pass.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "squash_mask(self, attach_sparsify_hook=True, **kwargs)", "description": "Removes aggregation hooks and optionally attaches sparsification hooks to enable masking during inference.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "_get_serializable_data_groups(self)", "description": "Prepares the configuration data for serialization by removing hooks and layer references.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "_convert_mask(self, states_dict, sparse_coo=True)", "description": "Converts masks to sparse COO format or dense tensors for storage or computation.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "dict[str,Any] state_dict(self)", "description": "Exports the current state of the sparsifier including masks and configurations.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "None load_state_dict(self, state_dict: dict[str, Any])", "description": "Loads a previously saved state into the sparsifier, restoring masks and configurations.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "dict[str,Any] __get_state__(self)", "description": "Serializes the internal state of the sparsifier.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "None __set_state__(self, state: dict[str, Any])", "description": "Restores the internal state of the sparsifier from a serialized state.", "scope": "ActivationSparsifier", "scopeKind": "class"}, {"name": "__repr_
ile}\\\"\\n\")", "endforeach()", "file(WRITE ${output_file} \"# Generated by: make2cmake.cmake\\nSET(CUDA_NVCC_DEPEND\\n ${cuda_nvcc_depend})\\n\")"], "search-terms": ["make2cmake", "dependency processing", "CUDA dependencies", "cmake script", "nvcc dependency", "makefile syntax"], "state": 2, "file_id": 2458, "knowledge_revision": 21861, "git_revision": "b1d62febd03ac421197d5516596f98d3c46e9b44", "hash": "50a1ca3adf40f193d1491068c700e275", "format-version": 4, "code-base-name": "pytorch-309884", "filename": "cmake/Modules_CUDA_fix/upstream/FindCUDA/make2cmake.cmake", "revision_history": [{"21861": "b1d62febd03ac421197d5516596f98d3c46e9b44"}]}
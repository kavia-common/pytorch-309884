{"is_source_file": true, "format": "Python", "description": "This file contains a custom implementation of a fallback tracer for Torch FX, named MetaTracer, which overrides methods to handle tensor metadata and specific tensor operations. It also defines several override functions for torch modules and functions, and a custom proxy class (MetaProxy) for tracing tensor operations with metadata handling.", "external_files": ["torch", "torch.fx", "builtins"], "external_methods": ["torch.fx.Proxy", "torch.fx.node.map_aggregate", "torch.fx.Tracer.create_proxy", "torch.fx.Proxy.install_tensor_meta", "torch.fx.Proxy.to", "torch.fx.Proxy.size", "torch.fx.Proxy.dim", "torch.fx.Proxy.shape", "torch.fx.Proxy.dtype", "torch.fx.Proxy.device", "torch.fx.Proxy.__getattr__", "torch.fx.node.map_aggregate", "torch.nn.Module", "warnings.warn"], "published": ["symbolic_trace", "MetaTracer", "MetaProxy", "MetaAttribute", "MetaDeviceAttribute", "gen_constructor_wrapper"], "classes": [{"name": "MetaProxy", "description": "A custom proxy class extending torch.fx.Proxy to support tensor metadata and install tensor metadata, size, shape, dtype, device, and attribute access handling."}, {"name": "MetaAttribute", "description": "Represents an attribute of a tensor in the meta-tracing context, facilitating attribute access and method calls during tracing."}, {"name": "MetaDeviceAttribute", "description": "A specialized MetaAttribute to track and handle device attribute access."}, {"name": "MetaTracer", "description": "Custom FX tracer that tracks tensor metadata during graph tracing, overrides create_proxy and other methods to handle metadata-aware proxy creation."}], "methods": [{"name": "embedding_override(self, input)", "description": "Overrides torch.nn.Embedding to create an empty tensor with the same shape as input, on meta device.", "scope": "", "scopeKind": ""}, {"name": "nn_layernorm_override(self, input)", "description": "Overrides torch.nn.LayerNorm to return the input unchanged.", "
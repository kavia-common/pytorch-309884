{"is_source_file": true, "format": "Python", "description": "This file defines the `ModuleTracker` class, a context manager for tracking the hierarchy of `nn.Module` instances during forward and backward passes in a PyTorch model. It hooks into module execution to monitor active modules, handle backward execution state, and records modules with their fully qualified names. It facilitates introspection of module execution flow for debugging or analysis purposes.", "external_files": ["torch", "torch.autograd.graph", "torch.nn.modules.module", "torch.utils._pytree", "torch.utils.hooks"], "external_methods": ["register_multi_grad_hook", "register_module_forward_hook", "register_module_forward_pre_hook"], "published": ["ModuleTracker"], "classes": [{"name": "ModuleTracker", "description": "A context manager for tracking the hierarchy of `nn.Module` instances during model execution, enabling introspection of active modules and their execution state during forward and backward passes."}], "methods": [{"name": "None __init__(self)", "description": "Initializes the `ModuleTracker` instance, setting up internal data structures and hook lists.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "None _maybe_set_engine_callback(self)", "description": "Registers a callback with the autograd engine to reset the active modules set during backward pass.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "is_bw(self)", "description": "Property that indicates whether the current execution is during the backward pass.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "_get_mod_name(self, mod)", "description": "Retrieves and caches the fully qualified name of a given module, traversing its children if necessary.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "_get_append_fn(self, name, is_bw)", "description": "Returns a function that adds a module name to the active parents set, handling backward or forward context.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "_get_pop_fn(self, name, is_bw)", "description": "Returns a function that removes a module name from the active parents set, handling backward or forward context.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "None _fw_pre_hook(self, mod, input)", "description": "Hook executed before a module's forward pass; updates parent set and registers gradient hooks for tensors requiring gradients.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "None _fw_post_hook(self, mod, input, output)", "description": "Hook executed after a module's forward pass; updates parent set and registers gradient hooks for output tensors requiring gradients.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "__enter__(self)", "description": "Enables the module hooks to start tracking during the context scope.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "__exit__(self, *args)", "description": "Removes hooks and clears registered gradient hooks upon exiting the context.", "scope": "ModuleTracker", "scopeKind": "class"}, {"name": "None callback()", "scope": "ModuleTracker._maybe_set_engine_callback", "scopeKind": "member", "description": "unavailable"}, {"name": "None fn(*args)", "scope": "ModuleTracker._get_pop_fn", "scopeKind": "member", "description": "unavailable"}], "calls": ["torch.autograd.Variable._execution_engine.queue_callback", "register_multi_grad_hook", "register_module_forward_pre_hook", "register_module_forward_hook"], "search-terms": ["ModuleTracker", "module hierarchy tracking", "PyTorch module execution", "forward/backward hook", "module name retrieval"], "state": 2, "file_id": 7512, "knowledge_revision": 26894, "git_revision": "a913b2bb938e6a8ccfa581fb24dc3f7fbaac7bd3", "ctags": [{"_type": "tag", "name": "ModuleTracker", "path": "/home/kavia/workspace/code-generation/pytorch-309884/torch/utils/module_tracker.py", "pattern": "/^class ModuleTracker:$/", "language": "Python", "kind": "class"}, {"_type"
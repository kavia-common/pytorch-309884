{"is_source_file": true, "format": "Python", "description": "This file defines layout classes and functions for manipulating multi-dimensional array layouts, including operations like coalescing, filtering, composition, inversion, and hierarchical division and product. It specifically supports lexicographic ordering in layout transformations relevant to the PyTorch distributed layout management, with custom logic for layout coalescing, complement, and inverse routines.", "external_files": ["./int_tuple"], "external_methods": ["chain", "product", "has_none", "crd2idx", "flatten", "is_tuple", "slice_", "suffix_product"], "published": ["is_layout", "make_layout", "size", "cosize", "coalesce", "filter", "composition", "complement", "right_inverse", "left_inverse", "logical_divide", "logical_product", "hier_unzip", "zipped_divide", "tiled_divide", "zipped_product", "tiled_product", "slice_and_offset"], "classes": [{"name": "LayoutBase", "description": "Base class for layout objects, primarily used for type checking."}, {"name": "Layout", "description": "Represents a multi-dimensional array layout with shape and stride. Provides methods for mapping coordinates to indices, slicing, size computations, and string representations."}], "methods": [{"name": "TypeIs[\"Layout\"] is_layout(x: object)", "description": "Type guard function to check if an object is an instance of Layout.", "scope": "", "scopeKind": ""}, {"name": "Layout make_layout(*layouts: Layout | tuple[Layout, ...])", "description": "Constructs a combined layout from multiple layout instances or tuples.", "scope": "", "scopeKind": ""}, {"name": "int size(self)", "description": "Returns the size (total number of elements) of the layout, whether from a Layout object or an integer tuple.", "scope": "Layout", "scopeKind": "class"}, {"name": "int cosize(self)", "description": "Returns the maximum index covered by the layout.", "scope": "Layout", "scopeKind": "class"}, {"name": "Layout coalesce(layout: Layout, profile: LayoutProfile = None)", "description": "Flattens and combines layout modes into as few as possible while preserving the indexing function, following lexicographic order.", "scope": "", "scopeKind": ""}, {"name": "Layout filter(layout: Layout, profile: LayoutProfile = None)", "description": "Removes modes with stride zero or shape one, replacing stride-zero modes with size one, then coalescing.", "scope": "", "scopeKind": ""}, {"name": "Layout composition(layoutA: Layout, layoutB: LayoutInput)", "description": "Composes two layouts, handling different input types, and performing mode composition.", "scope": "", "scopeKind": ""}, {"name": "Layout complement(layout: LayoutOrIntTuple, max_idx: int = 1)", "description": "Computes the complement of a layout up to max_idx, representing the unoccupied portion.", "scope": "", "scopeKind": ""}, {"name": "Layout|None right_inverse(layout: LayoutOrIntTuple | None)", "description": "Calculates the right inverse of a layout, if possible.", "scope": "", "scopeKind": ""}, {"name": "Layout|None left_inverse(layout: LayoutOrIntTuple | None)", "description": "Calculates the left inverse of a layout, using right_inverse and complement.", "scope": "", "scopeKind": ""}, {"name": "Layout logical_divide(layoutA: Layout, layoutB: LayoutInput)", "description": "Hierarchically divides layoutA by layoutB, supporting tensor product-like operation.", "scope": "", "scopeKind": ""}, {"name": "Layout logical_product(layoutA: Layout, layoutB: LayoutInput)", "description": "Hierarchically multiplies layoutA and layoutB to produce a combined layout.", "scope": "", "scopeKind": ""}, {"name": "Layout hier_unzip( splitter: object, layoutA: Layout, layoutB: LayoutInput, )", "description": "Recursively unzips layout relationships into two modes, based on a splitter function.", "scope": "", "scopeKind": ""}, {"name": "Layout zipped_divide(layoutA: Layout, layoutB: LayoutInput)", "description": "Performs hierarchical logical division and combines results in
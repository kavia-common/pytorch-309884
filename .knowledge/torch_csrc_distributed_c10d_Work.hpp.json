{"is_source_file": true, "format": "C++ header", "description": "This file declares the interface for distributed work operations within PyTorch's c10d distributed backend. It includes enums defining operation types and work results, as well as the Work class which manages asynchronous communication tasks such as broadcast, reduce, gather, and point-to-point send/receive operations. The file provides methods to check completion status, wait for completion, handle exceptions, synchronize tensors, and obtain future objects for work tracking.", "external_files": ["<ATen/ATen.h>", "<chrono>", "<mutex>", "<vector>"], "external_methods": ["opTypeToString(OpType)", "isP2POp(OpType, bool)"], "published": ["c10d::Work", "c10d::WorkInfo", "c10d::OpType", "c10d::WorkResult"], "classes": [{"name": "Work", "description": "Represents an asynchronous distributed communication operation in PyTorch, providing methods to check status, wait for completion, handle exceptions, synchronize tensors, and retrieve progress via futures."}, {"name": "WorkInfo", "description": "Stores metadata about a Work instance, including operation type, sequence number, start and finish times, and active duration."}], "methods": [{"name": "Work", "description": "Constructor initializing a Work object with optional parameters such as rank, operation type, profiling title, and input tensors."}, {"name": "isCompleted", "description": "Checks if the work operation has completed without blocking."}, {"name": "isSuccess", "description": "Returns true if the work completed successfully, false otherwise."}, {"name": "exception", "description": "Retrieves the exception if the work did not succeed."}, {"name": "sourceRank", "description": "Returns the source rank in case of a receive-from-any operation."}, {"name": "result", "description": "Returns result tensors of the work operation, if applicable."}, {"name": "synchronize", "description": "Ensures correct sequencing of operations with the output tensors after the asynchronous work completes."}, {"name": "wait", "description": "Blocks until the work completes or the optional timeout expires; throws if an exception occurred during the work."}, {"name": "blockCurrentStream", "description": "Blocks the current CUDA stream until the work finishes; applicable for both CPU and CUDA tensors."}, {"name": "abort", "description": "Aborts the ongoing work."}, {"name": "getFuture", "description": "Returns a Future object associated with the completion of the work."}, {"name": "getFutureResult", "description": "Returns a Future object that will be marked success or failure upon work completion, allowing external tracking."}, {"name": "getDuration", "description": "Returns the duration of the work execution."}, {"name": "getSequencenumber", "description": "Returns the sequence number associated with the work."}, {"name": "retrieveOpType", "description": "Returns the operation type of the work."}, {"name": "create_from_future", "description": "Creates a Work object from a given Future, enabling conversion from future-based asynchronous primitives."}, {"name": "finish", "description": "Completes the work object, optionally setting an exception, and notifies all waiters."}, {"name": "finishAndThrow", "description": "Completes the work and throws an exception if one is already set or provided."}, {"name": "WorkInfo(const OpType & opType,const uint64_t seq,const std::chrono::time_point<std::chrono::steady_clock> & timeStarted,const std::chrono::time_point<std::chrono::steady_clock> & timeFinished,const std::chrono::duration<float> & activeDuration)", "scope": "c10d::WorkInfo", "scopeKind": "struct", "description": "unavailable"}], "calls": ["opTypeToString(OpType)", "isP2POp(OpType, bool)"], "search-terms": ["distributed work", "PyTorch distributed", "c10d", "Work class", "async communication", "collective operations", "futures", "WorkResult enum", "OpType enum", "synchronize tensors", "blocking wait", "abort work"], "state": 2, "file_id": 77
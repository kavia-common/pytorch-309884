{"is_source_file": true, "format": "Python", "description": "This file defines the ModTracker class, a context manager that tracks the hierarchy of torch.nn.Module instances during execution. It provides mechanisms to query the current modules in active operation, register user hooks for forward and backward passes, and maintain module name mappings during model execution, aiding in debugging and introspection within the PyTorch distributed codebase.", "external_files": ["torch", "torch.autograd.graph", "torch.nn.modules.module", "torch.utils._pytree"], "external_methods": ["register_multi_grad_hook", "register_module_forward_hook", "register_module_forward_pre_hook", "weakref.WeakKeyDictionary", "weakref.WeakSet", "torch.autograd.Variable._execution_engine.queue_callback", "torch._C._current_graph_task_id", "warnings.formatwarning", "warnings.warn", "tree_flatten"], "published": ["ModTracker"], "classes": [{"name": "ModTracker", "description": "A context manager class that tracks the execution hierarchy of torch.nn.Module instances during forward and backward passes, allowing introspection and hook registration for debugging or profiling purposes."}], "methods": [{"name": "__init__(self)", "description": "Initializes the ModTracker with internal data structures to track active modules, known modules, and user hooks.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "_maybe_set_engine_callback(self)", "description": "Sets a callback in the autograd engine to reset the module tracking after backward passes.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "is_bw(self)", "description": "Property that indicates whether the current execution is in the backward pass.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "get_known_fqn(self, mod)", "description": "Returns the fully qualified name (fqn) of a given module if it is known.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "register_user_hooks( self, pre_fw_hook: Callable | None = None, post_fw_hook: Callable | None = None, pre_bw_hook: Callable | None = None, post_bw_hook: Callable | None = None, )", "description": "Allows users to register custom hooks to be called before/after forward and backward passes for tracked modules.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "clear_user_hooks(self)", "description": "Removes all user-registered hooks.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "_get_mod_name(self, mod)", "description": "Recursively retrieves or assigns a module's name within the tracking context.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "_get_append_fn(self, w_mod, name, is_bw)", "description": "Creates a function to handle module hierarchy updates during backward passes.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "_get_pop_fn(self, w_mod, name, is_bw)", "description": "Creates a function to update the module hierarchy when a module finishes backward execution.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "_fw_pre_hook(self, mod, input)", "description": "Hook called before a module's forward pass, updates tracking info and registers hooks for gradient computation.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "_fw_post_hook(self, mod, input, output)", "description": "Hook called after a module's forward pass, updates tracking info and registers hooks for gradient computation.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "__enter__(self)", "description": "Enables the context manager, registering hooks for module forward pre- and post-pass events.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "__exit__(self, *args)", "description": "Removes the hooks registered during __enter__, closing the context.", "scope": "ModTracker", "scopeKind": "class"}, {"name": "callback()", "scope": "ModTracker._maybe_set_engine_callback", "scopeKind": "member", "description": "unavailable"}, {"name": "custom_formatwarning(msg, category, filename, lineno, l
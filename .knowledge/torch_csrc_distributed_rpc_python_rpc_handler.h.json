{"is_source_file": true, "format": "C++ header (.h)", "description": "This file declares the PythonRpcHandler singleton class that provides an interface for executing Python user-defined functions (UDFs) remotely within PyTorch's distributed RPC framework. It includes methods for running Python UDFs, serializing/deserializing Python objects, handling exceptions, and managing related Python functions and type parsing, specifically for RRef (Remote Reference) mechanisms in distributed execution.", "external_files": ["torch/csrc/distributed/rpc/message.h", "torch/csrc/distributed/rpc/types.h", "torch/csrc/jit/frontend/script_type_parser.h", "torch/csrc/utils/pybind.h"], "external_methods": ["pybind11::object", "torch::jit::CompilationUnit", "torch::jit::ScriptTypeParser", "pybind11 methods used in the implementation (runPythonUdf, serialize, deserialize, handleException, etc.)"], "published": ["torch::distributed::rpc::PythonRpcHandler::getInstance", "torch::distributed::rpc::PythonRpcHandler::runPythonUdf", "torch::distributed::rpc::PythonRpcHandler::serialize", "torch::distributed::rpc::PythonRpcHandler::deserialize", "torch::distributed::rpc::PythonRpcHandler::handleException", "torch::distributed::rpc::PythonRpcHandler::isRemoteException", "torch::distributed::rpc::PythonRpcHandler::parseTypeFromStr", "torch::distributed::rpc::PythonRpcHandler::getRRefProxyFunctions", "torch::distributed::rpc::PythonRpcHandler::getRRefTypeFunctions"], "classes": [{"name": "PythonRpcHandler", "description": "A singleton class that provides an interface to execute remote Python UDFs, handle serialization/deserialization, manage exception handling in distributed RPC calls, and facilitate RRef (Remote Reference) functionalities within the PyTorch distributed framework."}], "methods": [{"name": "getInstance", "description": "Returns the singleton instance of PythonRpcHandler."}, {"name": "runPythonUdf", "description": "Executes a pickled Python UDF remotely and returns the result as a p